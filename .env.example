NODE_ENV=development
PORT=4000
API_PREFIX=/v1
LOG_LEVEL=info

# MongoDB. A new database name, so data from the earlier InsureHub build (database "insurehub") is untouched.
# A standalone server works for local testing; records that belong together are then written one after another.
# For real transactions (required in production), run MongoDB as a single-node replica set (see README).
MONGO_URI=mongodb://127.0.0.1:27017/bimayantra
# MONGO_REQUIRE_TRANSACTIONS=false

# Two Redis instances: cache (allkeys-lru) and queue (noeviction, for the job queue).
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=bimayantra-api
JWT_AUDIENCE=bimayantra-clients

# Browsers allow Secure cookies on http://localhost, but set false if your browser refuses them locally.
COOKIE_SECURE=false

# OTP hash pepper (32+ chars) and the two PAN/Aadhaar keys (32 bytes, base64). Generate keys with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OTP_PEPPER=change-me-otp-pepper-at-least-32-characters
PII_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY_AAAAAAAAAAA=
PII_HASH_KEY=REPLACE_WITH_ANOTHER_32_BYTE_BASE64_KEY_AAAA=

# 'dev' = OTP SMS go to the test inbox shown in the web console (never in production).
SMS_PROVIDER=dev
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=

# Test tools for the web console: SMS inbox, test clock, configuration overrides. Never in production.
DEV_TOOLS=true

# Private file storage (KYC documents, photos, logos, PDFs).
#   local      = ./storage on this machine (development only)
#   cloudinary = private Cloudinary assets (decision Q29). Check with: npm run storage:check
FILE_STORAGE=local
FILE_STORAGE_DIR=./storage
# Cloudinary console -> Settings -> API Keys. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Keep development and production apart. Production refuses a folder ending in -dev.
CLOUDINARY_FOLDER=bimayantra-dev
# Only if Cloudinary assigns your account a regional API host:
# CLOUDINARY_UPLOAD_PREFIX=https://api-ap.cloudinary.com

TERMS_VERSION=2026-10-v1
SUPPORT_EMAIL=support@bimayantra.in

CORS_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT=100kb

# First SkyUp Admin, created by `npm run seed:admin`. Sign in with this mobile number and the OTP.
SEED_ADMIN_NAME=SkyUp Admin
SEED_ADMIN_MOBILE=9900000000

# Automatic reading of Aadhaar, PAN and old policies (P-18). none = manual entry only.
# google = Google Document AI, plain OCR processor in Mumbai. Check with: npm run ocr:check <file> PAN
DOCUMENT_READER=none
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=asia-south1
DOCUMENT_AI_PROCESSOR_ID=
# Path to the service-account key (.json). Keep it OUTSIDE the project folder; never commit it.
DOCUMENT_AI_KEY_FILE=

{
  "name": "bimayantra-api",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Bimayantra API, built to Business Process Document v3.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed:admin": "tsx --env-file=.env src/scripts/seed-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:indexes": "tsx --env-file=.env src/scripts/sync-indexes.ts",
    "storage:check": "tsx --env-file=.env src/scripts/storage-check.ts"
  },
  "dependencies": {
    "cloudinary": "2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "ioredis-mock": "^8.13.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}